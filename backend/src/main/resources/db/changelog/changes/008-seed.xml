    <changeSet id="008-seed-data-sql" author="student">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <sqlFile path="data/seed_data.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sql>
